// Hardware pin mapping for external analog buzzer test (Hat/Grove connector)
#define EXTERNAL_BUZZER_PIN 1

enum AppState { MENU, EDIT_IP, EDIT_PING_COUNT, RUNNING_PING, SUMMARY, EDIT_WIFI };
AppState currentState = MENU;

// CHANGE YOUR CREDENTIALS HERE FOR AUTO-CONNECT
String targetIp = "8.8.8.8";
int maxPings = 0; 
String wifiSsid = "WIFI_SSID";
String wifiPass = "WIFI_PASS";

int currentPingCount = 0;
int successfulPings = 0;
int failedPings = 0;
bool soundEnabled = true;
String logReport = "";

String* activeStringPtr = nullptr;
char currentChar = '0';
int menuIndex = 0;

const int BEEP_SUCCESS_FREQ = 2200;
const int BEEP_SUCCESS_DURATION = 80;
const int BEEP_FAILURE_FREQ = 500;
const int BEEP_FAILURE_DURATION = 1000;

WebServer server(80);

unsigned long btnBLastDebounceTime = 0;
bool btnBPrevState = false;
int btnBClickCounter = 0;
unsigned long btnBLastClickTime = 0;
bool btnBLongPressTriggered = false;

void drawMenu();
void handleMenuInput();
void handleTextInput();
void handlePingCountEditor();
void executePingIteration();
void handleSummaryInput();
void drawTextEditor(String title, String currentText);
void drawPingCountEditor();
void drawSummaryScreen();

String getFormattedTime() {
    struct tm timeinfo;
    if (!getLocalTime(&timeinfo)) {
        return "time"; 
    }
    char timeStringBuff[20];
    strftime(timeStringBuff, sizeof(timeStringBuff), "%Y/%m/%d %H:%M:%S", &timeinfo);
    return String(timeStringBuff);
}

void triggerBeep(int frequency, int duration) {
    if (!soundEnabled) return;
    // Method 1: Hybrid hardware fallback using physical analog pin (Arduino tone style)
    pinMode(EXTERNAL_BUZZER_PIN, OUTPUT);
    tone(EXTERNAL_BUZZER_PIN, frequency, duration);
    M5.Speaker.tone(frequency, duration); 
    unsigned long start = millis();
    while (millis() - start < duration) {
        M5.update();
        delay(1);
    }
    // Explicit clean stop parameters for analog pin line
    noTone(EXTERNAL_BUZZER_PIN);
    digitalWrite(EXTERNAL_BUZZER_PIN, LOW);
}

void handleRoot() {
    String html = "<html><head><title>Ping Monitor Remote Terminal</title>";
    html += "<meta name='viewport' content='width=device-width, initial-scale=1.0'>";
    html += "<style>body{font-family:Arial;padding:20px;background:#f0f2f5;}input{width:100%;padding:10px;margin:8px 0;box-sizing:border-box;}button{background:#007bff;color:white;padding:12px;border:none;width:100%;cursor:pointer;font-size:16px;margin-top:10px;}</style></head><body>";
    html += "<h2>Ping Monitor</h2>";
    
    html += "<form action='/save_config' method='POST'>";
    html += "<h3>Network Settings</h3>";
    html += "WiFi SSID:<br><input type='text' name='ssid' value='" + wifiSsid + "'><br>";
    html += "WiFi Password:<br><input type='password' name='pass' value='" + wifiPass + "'><br>";
    html += "<button type='submit'>Save Profile & Restart</button>";
    html += "</form>";
    html += "<form action='/set_ip' method='POST'>";
    html += "<h3>Target Parameters</h3>";
    html += "Target Destination IP:<br><input type='text' name='target' value='" + targetIp + "'><br>";
    html += "<button type='submit'>Set IP</button>";
    html += "</form><hr>";

    html += "<h3>Telemetry Reports</h3>";
    if (LittleFS.exists("/ping_report.csv")) {
        html += "<p><a href='/download'><button style='background:#28a745;'>Download Latest Report (.CSV)</button></a></p>";
    } else {
        html += "<p style='color:grey;'>No report available on internal memory partition.</p>";
    }
    html += "</body></html>";
    server.send(200, "text/html", html);
}

void handleSaveConfig() {
    if (server.hasArg("ssid")) wifiSsid = server.arg("ssid");
    if (server.hasArg("pass")) wifiPass = server.arg("pass");
    
    server.send(200, "text/html", "<html><body><h3>Configuration Saved! Rebooting device...</h3></body></html>");
    delay(2000);
    ESP.restart();
}

void handleSaveIP() {
    if (server.hasArg("target")) targetIp = server.arg("target");
    handleRoot();
}
void handleFileDownload() {
    if (!LittleFS.exists("/ping_report.csv")) {
        server.send(404, "text/plain", "File Not Found.");
        return;
    }
    File file = LittleFS.open("/ping_report.csv", "r");
    if (file) {
        String safeIp = targetIp;
        safeIp.replace(".", "_");
        String filename = "ping_" + safeIp + "_" + getFormattedTime() + ".csv";
        
        server.sendHeader("Content-Disposition", "attachment; filename=" + filename);
        server.streamFile(file, "text/csv");
        file.close();
    } else {
        server.send(500, "text/plain", "Internal read failure.");
    }
}

void setup() {
    auto cfg = M5.config();
    cfg.internal_spk = true;
    M5.begin(cfg);
    
    M5.In_I2C.release(); 
    M5.Display.begin();
    M5.Display.setRotation(1);       
    M5.Display.setBrightness(150);   
    M5.Display.fillScreen(BLACK);
    M5.Display.setTextSize(1); 
    
    M5.Speaker.begin();
    M5.Speaker.setVolume(255);
    
    // Open mixer channel to guarantee audio delivery
    M5.Speaker.setChannelVolume(1, 255);   

    if (!LittleFS.begin(true)) {
        M5.Display.println("Storage Error!");
        delay(2000);
    }
    
    server.on("/", handleRoot);
    server.on("/save_config", handleSaveConfig);
    server.on("/set_ip", handleSaveIP);
    server.on("/download", handleFileDownload);

    M5.Display.println("Booting Server...");
    WiFi.begin(wifiSsid.c_str(), wifiPass.c_str());
    
    int connTimeout = 0;
    while (WiFi.status() != WL_CONNECTED && connTimeout < 12) {
        delay(500);
        M5.Display.print(".");
        connTimeout++;
    }
    
    if (WiFi.status() == WL_CONNECTED) {
        configTime(-3 * 3600, 0, "pool.ntp.org", "time.nist.gov");
        server.begin();
        M5.Display.printf("\nWiFi Online!\nIP Web Address: %s\n", WiFi.localIP().toString().c_str());
        triggerBeep(2000, 250); // Initial boot confirmation chime
    } else {
        M5.Display.println("\nWiFi Offline. Standalone Mode active.");
    }
    delay(2500);
    drawMenu();
}

void loop() {
    M5.update();
    server.handleClient(); 
    
    switch (currentState) {
        case MENU:             handleMenuInput();       break;
        case EDIT_IP:
        case EDIT_WIFI:        handleTextInput();       break;
        case EDIT_PING_COUNT:  handlePingCountEditor(); break;
        case RUNNING_PING:     executePingIteration();  break;
        case SUMMARY:          handleSummaryInput();    break;
    }
    delay(30);
}

void drawMenu() {
    M5.Display.fillScreen(BLACK);
    M5.Display.setTextColor(GREEN);
    M5.Display.setCursor(10, 5);
    M5.Display.println("=== Ping Monitor ===");
    M5.Display.setTextColor(WHITE);
    M5.Display.printf("Web UI Server status: %s\n\n", WiFi.status() == WL_CONNECTED ? WiFi.localIP().toString().c_str() : "OFFLINE");
    
    if (menuIndex == 0) M5.Display.setTextColor(YELLOW);
    M5.Display.printf("%s 1. Enter IP (%s)\n", (menuIndex == 0 ? ">" : " "), targetIp.c_str());
    M5.Display.setTextColor(WHITE);
    
    if (menuIndex == 1) M5.Display.setTextColor(YELLOW);
    M5.Display.printf("%s 2. Connect WiFi (%s)\n", (menuIndex == 1 ? ">" : " "), WiFi.status() == WL_CONNECTED ? "Connected" : "Disconnected");
}

