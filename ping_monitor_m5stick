    M5.Display.fillScreen(BLACK);
    M5.Display.setCursor(10, 5);
    M5.Display.setTextColor(GREEN);
    M5.Display.println("--- Test Summary ---");
    M5.Display.setTextColor(WHITE);
    M5.Display.printf("Total: %d | Success: %d | Failed: %d\n", currentPingCount, successfulPings, failedPings);
    
    M5.Display.setTextColor(YELLOW);
    M5.Display.println("\nOptions (Front Button):");
    M5.Display.println("Click: Resume Test");
    M5.Display.println("Long Press: Commit File to Storage");
