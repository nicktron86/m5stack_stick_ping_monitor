void handleMenuInput() {
    if (M5.BtnB.wasClicked()) {
        menuIndex = (menuIndex == 0) ? 1 : 0;
        drawMenu();
    }
    if (M5.BtnA.wasClicked()) {
        if (menuIndex == 0) {
            currentState = EDIT_IP;
            activeStringPtr = &targetIp;
            currentChar = '0';
            drawTextEditor("Target IP Configuration", *activeStringPtr);
        } else if (menuIndex == 1) {
            currentState = EDIT_WIFI;
            activeStringPtr = &wifiSsid; 
            currentChar = 'A';
            drawTextEditor("Enter WiFi SSID", *activeStringPtr);
        }
    }
}

void handleTextInput() {
    unsigned long now = millis();
    bool btnBPressed = M5.BtnB.isPressed();

    // 1. Long Press Detection logic loop (Side Button - B to confirm current char)
    if (btnBPressed) {
        if ((now - btnBLastDebounceTime > 600) && !btnBLongPressTriggered && btnBPrevState) {
            btnBLongPressTriggered = true;
            btnBClickCounter = 0;
            // Action -> Append character to the active string
            *activeStringPtr += currentChar;
            
            // Reset character preview selector back to standard baseline '0'
            currentChar = '0'; 
            drawTextEditor(currentState == EDIT_IP ? "Target IP" : "WiFi Setup", *activeStringPtr);
        }
    }

    // 2. Capture state transitions (Release bounds)
    if (!btnBPressed && btnBPrevState) {
        btnBLastDebounceTime = now;
        if (!btnBLongPressTriggered) {
            btnBClickCounter++;
            btnBLastClickTime = now;
        }
        btnBLongPressTriggered = false;
    }
    
    if (btnBPressed && !btnBPrevState) {
        btnBLastDebounceTime = now;
    }
    btnBPrevState = btnBPressed;

    // 3. Process Clicks after specific timeout frame (280ms)
    if (btnBClickCounter > 0 && (now - btnBLastClickTime > 280) && !btnBPressed) {
        if (btnBClickCounter == 2) { // Double Click -> Previous Char (Allows any printable ASCII char)
            currentChar--;
            if (currentChar < 32) currentChar = 126; // Cycles backward past printable space bounds down to '~'
        } 
        else if (btnBClickCounter == 1) { // Single Click -> Next Char (Allows any printable ASCII char)
            currentChar++;
            if (currentChar > 126) currentChar = 32; // Cycles forward past '~' back up to basic space bounds
        }
        btnBClickCounter = 0;
        drawTextEditor(currentState == EDIT_IP ? "Target IP" : "WiFi Setup", *activeStringPtr + currentChar);
    }

    // 4. Backspace Execution mapping via Front Button Hold (Button A)
    if (M5.BtnA.wasHold()) {
        if (activeStringPtr->length() > 0) {
            activeStringPtr->remove(activeStringPtr->length() - 1);
        }
        currentChar = '0'; 
        drawTextEditor(currentState == EDIT_IP ? "Target IP" : "WiFi Setup", *activeStringPtr);
        return;
    }

    // 5. Single Click Front Button (Button A) -> Confirms and saves the complete profile entry
    if (M5.BtnA.wasClicked()) {
        if (currentState == EDIT_IP) { 
            currentState = EDIT_PING_COUNT; 
            drawPingCountEditor(); 
        }
        else if (currentState == EDIT_WIFI) {
            if (activeStringPtr == &wifiSsid) { 
                activeStringPtr = &wifiPass; 
                *activeStringPtr = ""; 
                currentChar = '0'; 
                drawTextEditor("Enter WiFi Password", *activeStringPtr); 
            }
            else { 
                M5.Display.fillScreen(BLACK); 
                M5.Display.println("Saving WiFi..."); 
                WiFi.begin(wifiSsid.c_str(), wifiPass.c_str()); 
                delay(1500); 
                currentState = MENU; 
                drawMenu(); 
            }
        }
    }
}

void handlePingCountEditor() {
    if (M5.BtnB.wasClicked()) {
        maxPings += 5;
    if (maxPings > 100) maxPings = 0;
        drawPingCountEditor();
    }
    if (M5.BtnB.wasHold()) {
        maxPings -= 5;
    if (maxPings < 0) maxPings = 100;
        drawPingCountEditor();
    }
    if (M5.BtnA.wasHold()) {
        maxPings = 0;
        drawPingCountEditor();
    }
    else if (M5.BtnA.wasClicked()) {
        currentState = RUNNING_PING;
        currentPingCount = 0; successfulPings = 0; failedPings = 0;
        logReport = "Sequence,Timestamp,Target_IP,Status,Response_Time_ms\n";
        M5.Display.fillScreen(BLACK);
        M5.Display.setCursor(0, 0);
        M5.Display.println("Ping to target: "+String(targetIp));
    }
}
void executePingIteration() {
    bool abortTest = false;
    if (M5.BtnB.wasHold()) soundEnabled = !soundEnabled;
    if (M5.BtnA.wasHold() || M5.BtnA.wasClicked()) abortTest = true;
    if (abortTest || (maxPings > 0 && currentPingCount >= maxPings)) {
        currentState = SUMMARY;
        drawSummaryScreen();
        return;
    }
    currentPingCount++;
    IPAddress target;
    bool parseSuccess = target.fromString(targetIp);
    bool pingResult = parseSuccess ? Ping.ping(target, 1) : Ping.ping(targetIp.c_str(), 1);
    String outputLine = "";
    String timeStampStr = getFormattedTime();
    if (pingResult) {
        successfulPings++;
        int msTime = Ping.averageTime();
        outputLine = String(currentPingCount) + ": Reply time=" + String(msTime) + "ms\n";
        logReport += String(currentPingCount) + "," + timeStampStr + "," + targetIp + ",SUCCESS," + String(msTime) + "\n";
        M5.Display.setTextColor(GREEN);
        triggerBeep(BEEP_SUCCESS_FREQ, BEEP_SUCCESS_DURATION);
    } else {
        failedPings++;
        outputLine = String(currentPingCount) + ": Request timed out.\n";
        logReport += String(currentPingCount) + "," + timeStampStr + "," + targetIp + ",TIMEOUT,0\n";
        M5.Display.setTextColor(RED);
        triggerBeep(BEEP_FAILURE_FREQ, BEEP_FAILURE_DURATION);
    }
    if (M5.Display.getCursorY() > M5.Display.height() - 15) {
        M5.Display.fillScreen(BLACK); 
        M5.Display.setCursor(0, 0);
    }
    M5.Display.print(outputLine);
    delay(1000);
}
void handleSummaryInput() {
    if (M5.BtnA.wasHold()) {
        M5.Display.fillScreen(BLACK); 
        M5.Display.setCursor(10, 30);
        File logFile = LittleFS.open("/ping_report.csv", "w");
        if (logFile) {
            logFile.print(logReport); 
            logFile.close();
            M5.Display.println("Saved CSV to Storage!");
        } else {
            M5.Display.println("Storage Error!");
        }
        delay(2000); drawSummaryScreen();
    } else if (M5.BtnA.wasClicked()) {
        currentState = RUNNING_PING;
        M5.Display.fillScreen(BLACK); 
        M5.Display.setCursor(0, 0);
        M5.Display.println("Resuming...");
    } else if (M5.BtnB.wasClicked()) {
        currentState = MENU;
        drawMenu();
    }
}
